NODE_ENV=development
PORT=3000

# PostgreSQL (usuario:clave@host:puerto/base)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/norcor?schema=public

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m

CORS_ORIGIN=http://localhost:5173

# Peticiones HTTP en la terminal: changes (POST/PATCH/DELETE y errores), all (también GET) u off
LOG_HTTP=changes

# Correo para recuperar contraseñas. Sin SMTP_HOST, en desarrollo el código se muestra en la terminal.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una "contraseña de aplicación" en SMTP_PASS.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SIVEN · NORCOR <no-responder@norcor.local>"

# Solo para el seed inicial (npx prisma db seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@norcor.local
