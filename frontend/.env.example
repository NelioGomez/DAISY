# Copiar como .env y ajustar. Solo las variables con prefijo VITE_ llegan al navegador.

# Ruta de la API vista desde el navegador. Con el proxy de Vite basta /api/v1.
VITE_API_URL=/api/v1

# A dónde reenvía Vite las llamadas /api en desarrollo (el backend NestJS).
VITE_BACKEND_URL=http://localhost:3000

# Muestra el panel "Cuentas de prueba" en el login fuera de `npm run dev` (p. ej. para la defensa).
# Dejar en false en cualquier despliegue real.
VITE_DEMO_ACCOUNTS=false

# Servidor de WebSocket si no es el mismo sitio (en desarrollo se usa el proxy /socket.io)
# VITE_WS_URL=http://localhost:3000

# Dominios de cada parte en producción (por omisión los de Vercel). La app manda al dominio correcto
# las rutas del otro: /login, /recuperar, /app y /admin van al sistema; lo demás, al sitio público.
# VITE_SITE_URL=https://norcor-catalogo.vercel.app
# VITE_SYSTEM_URL=https://siven.vercel.app
